# Required for /v1/ask and the generation eval (retrieval works without it).
ANTHROPIC_API_KEY=

# Optional: protect the API with a bearer token.
# API_TOKEN=change-me

# Vector store: http(s) URL, ":memory:", or a local path for embedded mode.
# QDRANT_URL=http://localhost:6333

# Models (defaults shown).
# LLM_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-opus-5-5
# ANSWER_EFFORT=low
# JUDGE_EFFORT=medium
# LLM_FALLBACKS=true       # server-side refusal fallback (beta header server-side-fallback-2026-07-01)
# LLM_CACHE=true           # SQLite response cache under data/cache/

# Serving defaults (chosen from results/REPORT.md).
# DEFAULT_STRATEGY=structural
# DEFAULT_MODE=hybrid
# DEFAULT_RERANK=false
# DEFAULT_RECITALS=false
# DEFAULT_K=6
